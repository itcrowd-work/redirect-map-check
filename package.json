{
  "name": "redirect-map-check",
  "version": "0.2.1",
  "description": "Check a website migration's 301 redirect map before and after launch: 404s, redirect chains, loops, 302s, redirects to the homepage or an unrelated page, and old URLs missing from the map.",
  "type": "module",
  "bin": {
    "redirect-map-check": "bin/redirect-map-check.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./inputs": "./src/inputs.js",
    "./csv": "./src/csv.js",
    "./url": "./src/url.js",
    "./http": "./src/http.js",
    "./content": "./src/content.js",
    "./report-style": "./src/report/style.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node demo/run.js",
    "demo:ui": "node demo/ui.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "redirects",
    "301",
    "redirect-map",
    "website-migration",
    "seo",
    "sitemap",
    "redirect-chain",
    "404",
    "cli",
    "webflow",
    "shopify"
  ],
  "author": "ITCrowd (https://itcrowd.work)",
  "homepage": "https://itcrowd.work/tools/redirect-map-check/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itcrowd-work/redirect-map-check.git"
  },
  "bugs": {
    "url": "https://github.com/itcrowd-work/redirect-map-check/issues"
  },
  "license": "MIT"
}
